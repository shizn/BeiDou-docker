# Copy this file to .env and set values for THIS machine.
# (.env is gitignored; .env.example is the shared, committed template.)
#
# GMS_HOST: the IP the login server (port 8484) hands to clients so they can reach
# the channel servers (7575-7577) and the web UI (8686).
#   - LAN play:          your machine's LAN IP    e.g. 192.168.68.91
#   - Tailscale / remote: your Tailscale 100.x IP  e.g. 100.93.134.5  (stable across networks)
#
# A wrong value here is the usual cause of "character-select kicks me back to login".
# See README section "关于 IP 设置".
GMS_HOST=192.168.x.x
